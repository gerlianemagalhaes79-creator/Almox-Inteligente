rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      let email = request.auth.token.email;
      let userDocPath = /databases/$(database)/documents/users/$(email);
      return isAuthenticated() && (
        (exists(userDocPath) && (get(userDocPath).data.role == 'ADMIN' || get(userDocPath).data.sector == 'Almoxarifado')) ||
        (email == "gerlianemagalhaes79@gmail.com" || email == "poli.almoxarifado@gmail.com")
      );
    }

    function isPharmacyUser() {
      let userDocPath = /databases/$(database)/documents/users/$(request.auth.token.email);
      return isAuthenticated() && exists(userDocPath) && get(userDocPath).data.sector == 'Farmácia';
    }

    function isSetor() {
      return isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'SETOR';
    }

    function isValidRequest(data) {
      return data.keys().hasAll(['sector', 'date', 'status', 'requesterEmail']) &&
             data.sector is string && data.sector.size() < 100 &&
             data.requesterEmail is string && data.requesterEmail.size() < 150 &&
             data.status in ['PENDENTE', 'APROVADO', 'SEPARADO', 'ENTREGUE', 'RECUSADO'] &&
             (!('observation' in data) || (data.observation is string && data.observation.size() < 500));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'date', 'read']) &&
             data.userId is string &&
             data.title is string && data.title.size() < 200 &&
             data.message is string && data.message.size() < 2000 &&
             data.date is string &&
             data.read is bool &&
             (!('requestId' in data) || (data.requestId is string)) &&
             (!('type' in data) || (data.type in ['system', 'request', 'pca']));
    }

    function isValidPCARequest(data) {
      return data.keys().hasAll(['itemType', 'itemName', 'unit', 'estimatedAnnualQuantity', 'justification', 'sector', 'userName', 'date']) &&
             data.itemType is string && data.itemType.size() < 100 &&
             data.itemName is string && data.itemName.size() < 200 &&
             data.unit is string && data.unit.size() < 50 &&
             data.estimatedAnnualQuantity is number &&
             data.justification is string && data.justification.size() < 1000 &&
             data.sector is string && data.sector.size() < 100 &&
             data.userName is string && data.userName.size() < 100 &&
             data.date is string;
    }

    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isPharmacyUser() && request.resource.data.location == 'Farmácia');
      allow update: if isAdmin() || (isPharmacyUser() && resource.data.location == 'Farmácia' && request.resource.data.location == 'Farmácia');
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                    request.resource.data.keys().hasAll(['item_id', 'item_name', 'type', 'quantity', 'date']) &&
                    request.resource.data.quantity is number && request.resource.data.quantity > 0;
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidRequest(request.resource.data);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.requesterEmail == request.auth.token.email && 
        resource.data.status == 'PENDENTE'
      );
      allow delete: if isAdmin();
    }

    match /request_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (
        isAuthenticated() && 
        resource.data.request_id != null &&
        exists(/databases/$(database)/documents/requests/$(resource.data.request_id)) && 
        get(/databases/$(database)/documents/requests/$(resource.data.request_id)).data.requesterEmail == request.auth.token.email &&
        get(/databases/$(database)/documents/requests/$(resource.data.request_id)).data.status == 'PENDENTE'
      );
    }

    match /users/{email} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && request.auth.token.email == email);
      allow update: if isAdmin() || (isAuthenticated() && request.auth.token.email == email && 
                    request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /pca_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidPCARequest(request.resource.data);
      allow update, delete: if isAdmin();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "gerlianemagalhaes79@gmail.com" || request.auth.token.email == "poli.almoxarifado@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'ADMIN' || 
           get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.sector == 'Almoxarifado'))
      );
    }

    function isPharmacyUser() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.sector == 'Farmácia';
    }

    function isSetor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'SETOR';
    }

    function isValidRequest(data) {
      return data.keys().hasAll(['sector', 'date', 'status', 'requesterEmail']) &&
             data.sector is string && data.sector.size() < 100 &&
             data.requesterEmail is string && data.requesterEmail.size() < 150 &&
             data.status in ['PENDENTE', 'EM_SEPARACAO', 'APROVADO', 'SEPARADO', 'ENTREGUE', 'RECUSADO', 'DEVOLUCAO_PENDENTE', 'DEVOLUCAO_APROVADA', 'DEVOLUCAO_RECUSADA'] &&
             (!('observation' in data) || (data.observation is string && data.observation.size() < 1000));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'date', 'read']) &&
             data.userId is string &&
             data.title is string && data.title.size() < 100 &&
             data.message is string && data.message.size() < 1000 &&
             data.date is string &&
             data.read is bool;
    }

    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isPharmacyUser() && request.resource.data.location == 'Farmácia');
      allow update: if isAdmin() || (isPharmacyUser() && resource.data.location == 'Farmácia' && request.resource.data.location == 'Farmácia');
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                    request.resource.data.keys().hasAll(['item_id', 'item_name', 'type', 'quantity', 'date']) &&
                    request.resource.data.quantity is number && request.resource.data.quantity > 0;
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidRequest(request.resource.data);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.requesterEmail == request.auth.token.email && 
        (resource.data.status in ['PENDENTE', 'DEVOLUCAO_PENDENTE'] || request.resource.data.status in ['PENDENTE', 'DEVOLUCAO_PENDENTE'])
      );
      allow delete: if isAdmin();
    }

    match /request_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (
        isAuthenticated() && 
        resource.data.request_id != null &&
        exists(/databases/$(database)/documents/requests/$(resource.data.request_id)) && 
        get(/databases/$(database)/documents/requests/$(resource.data.request_id)).data.requesterEmail == request.auth.token.email &&
        (get(/databases/$(database)/documents/requests/$(resource.data.request_id)).data.status in ['PENDENTE', 'DEVOLUCAO_PENDENTE'])
      );
    }

    match /users/{email} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow update: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email || (resource.data.userId == 'ADMIN_GROUP' && isAdmin()) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        (resource.data.userId == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        (resource.data.userId == 'ADMIN_GROUP' && isAdmin()) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email || (resource.data.userId == 'ADMIN_GROUP' && isAdmin()) || isAdmin());
    }

    match /dismissed_stock_alerts/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "gerlianemagalhaes79@gmail.com" || request.auth.token.email == "poli.almoxarifado@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'ADMIN' || 
           get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.sector == 'Almoxarifado'))
      );
    }

    function isPharmacyUser() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.sector == 'Farmácia';
    }

    function isSetor() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.token.email)) && 
             get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.role == 'SETOR';
    }

    function isValidRequest(data) {
      return data.keys().hasAll(['sector', 'date', 'status', 'requesterEmail']) &&
             data.sector is string && data.sector.size() < 100 &&
             data.requesterEmail is string && data.requesterEmail.size() < 150 &&
             data.status in ['PENDENTE', 'EM_SEPARACAO', 'APROVADO', 'SEPARADO', 'ENTREGUE', 'RECUSADO', 'DEVOLUCAO_PENDENTE', 'DEVOLUCAO_APROVADA', 'DEVOLUCAO_RECUSADA'] &&
             (!('observation' in data) || (data.observation is string && data.observation.size() < 1000));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'date', 'read']) &&
             data.userId is string &&
             data.title is string && data.title.size() < 100 &&
             data.message is string && data.message.size() < 1000 &&
             data.date is string &&
             data.read is bool;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPurchasePlan(data) {
      return data.keys().hasAll(['code', 'title', 'status', 'modality', 'location', 'items', 'totalItems', 'totalUnits', 'totalEstimatedCost', 'createdAt', 'updatedAt', 'createdBy', 'createdByEmail']) &&
             data.keys().hasOnly(['code', 'title', 'status', 'modality', 'location', 'targetPeriodLabel', 'targetMonth', 'targetYear', 'historyWindowDays', 'leadTimeDays', 'safetyOption', 'budgetCap', 'protocolNumber', 'notes', 'items', 'totalItems', 'totalUnits', 'totalEstimatedCost', 'createdAt', 'updatedAt', 'createdBy', 'createdByEmail']) &&
             data.code is string && data.code.size() >= 1 && data.code.size() <= 40 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.status in ['RASCUNHO', 'ENVIADO', 'EMPENHADO', 'PARCIAL', 'CONCLUIDO', 'CANCELADO'] &&
             data.modality in ['ATA_CONTRATO', 'LICITACAO', 'COMPRA_EXTRA', 'DISPENSA', 'GERAL'] &&
             data.location in ['Almoxarifado', 'Farmácia', 'all'] &&
             data.items is list && data.items.size() <= 500 &&
             data.totalItems is number && data.totalItems >= 0 &&
             data.totalUnits is number && data.totalUnits >= 0 &&
             data.totalEstimatedCost is number && data.totalEstimatedCost >= 0 &&
             data.createdAt is string && data.createdAt.size() <= 60 &&
             data.updatedAt is string && data.updatedAt.size() <= 60 &&
             data.createdBy is string && data.createdBy.size() <= 120 &&
             data.createdByEmail is string && data.createdByEmail.size() <= 150 &&
             (!('targetPeriodLabel' in data) || (data.targetPeriodLabel is string && data.targetPeriodLabel.size() <= 60)) &&
             (!('protocolNumber' in data) || (data.protocolNumber is string && data.protocolNumber.size() <= 80)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('budgetCap' in data) || data.budgetCap == null || (data.budgetCap is number && data.budgetCap >= 0));
    }

    function isValidPurchaseExclusion(data) {
      return data.keys().hasAll(['materialKey', 'materialName', 'location', 'reason', 'excludedAt', 'excludedBy', 'excludedByEmail']) &&
             data.keys().hasOnly(['materialKey', 'materialName', 'category', 'location', 'reason', 'replacedBy', 'note', 'excludedAt', 'excludedBy', 'excludedByEmail']) &&
             data.materialKey is string && data.materialKey.size() >= 1 && data.materialKey.size() <= 200 &&
             data.materialName is string && data.materialName.size() >= 1 && data.materialName.size() <= 200 &&
             data.location in ['Almoxarifado', 'Farmácia', 'all'] &&
             data.reason in ['COMPRA_OCASIONAL', 'SUBSTITUIDO', 'DESCONTINUADO', 'OUTRO'] &&
             data.excludedAt is string && data.excludedAt.size() <= 60 &&
             data.excludedBy is string && data.excludedBy.size() <= 120 &&
             data.excludedByEmail is string && data.excludedByEmail.size() <= 150 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 120)) &&
             (!('replacedBy' in data) || (data.replacedBy is string && data.replacedBy.size() <= 200)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    match /items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isPharmacyUser() && request.resource.data.location == 'Farmácia');
      allow update: if isAdmin() || (isPharmacyUser() && resource.data.location == 'Farmácia' && request.resource.data.location == 'Farmácia');
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                    request.resource.data.keys().hasAll(['item_id', 'item_name', 'type', 'quantity', 'date']) &&
                    request.resource.data.quantity is number && request.resource.data.quantity > 0;
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidRequest(request.resource.data);
      allow update: if isAdmin() || (
        isAuthenticated() && 
        resource.data.requesterEmail == request.auth.token.email && 
        (resource.data.status in ['PENDENTE', 'DEVOLUCAO_PENDENTE'] || request.resource.data.status in ['PENDENTE', 'DEVOLUCAO_PENDENTE'])
      );
      allow delete: if isAdmin();
    }

    match /request_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (
        isAuthenticated() && 
        resource.data.request_id != null &&
        exists(/databases/$(database)/documents/requests/$(resource.data.request_id)) && 
        get(/databases/$(database)/documents/requests/$(resource.data.request_id)).data.requesterEmail == request.auth.token.email &&
        (get(/databases/$(database)/documents/requests/$(resource.data.request_id)).data.status in ['PENDENTE', 'DEVOLUCAO_PENDENTE'])
      );
    }

    match /users/{email} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow update: if isAuthenticated() && (request.auth.token.email == email || isAdmin());
      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email || (resource.data.userId == 'ADMIN_GROUP' && isAdmin()) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        (resource.data.userId == request.auth.token.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
        (resource.data.userId == 'ADMIN_GROUP' && isAdmin()) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == request.auth.token.email || (resource.data.userId == 'ADMIN_GROUP' && isAdmin()) || isAdmin());
    }

    match /dismissed_stock_alerts/{id} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /document_templates/{templateId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /inventory_completions/{completionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /purchase_plans/{planId} {
      allow get: if isAuthenticated() && isValidId(planId);
      allow list: if isAuthenticated();
      allow create: if isAdmin() && isValidId(planId) && isValidPurchasePlan(request.resource.data);
      allow update: if isAdmin() && isValidId(planId) && isValidPurchasePlan(request.resource.data);
      allow delete: if isAdmin() && isValidId(planId);
    }

    match /purchase_planning_exclusions/{exclusionId} {
      allow get: if isAuthenticated() && isValidId(exclusionId);
      allow list: if isAuthenticated();
      allow create: if isAdmin() && isValidId(exclusionId) && isValidPurchaseExclusion(request.resource.data);
      allow update: if isAdmin() && isValidId(exclusionId) && isValidPurchaseExclusion(request.resource.data);
      allow delete: if isAdmin() && isValidId(exclusionId);
    }
  }
}
